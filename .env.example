# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-generate-with-python-secrets-module

# ===============================================================
# Database Configuration (MySQL)
# Set DB_TARGET=deployed (Cloud/Railway) or DB_TARGET=local (Localhost)
# ===============================================================
DB_TARGET=deployed

# Deployed / Cloud Database Credentials
DEPLOYED_DB_HOST=your-cloud-mysql-host
DEPLOYED_DB_PORT=3306
DEPLOYED_DB_USER=your-cloud-mysql-user
DEPLOYED_DB_PASSWORD=your-cloud-mysql-password
DEPLOYED_DB_NAME=railway
DEPLOYED_DB_SSL=true

# Local Database Credentials
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=your-local-password
LOCAL_DB_NAME=medical_equipment
LOCAL_DB_SSL=false

# Standard / Active DB Credentials (used directly by Render / Cloud)
DB_HOST=your-mysql-host
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=medical_equipment
DB_PORT=3306
DB_SSL=true

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-here

# SMTP Configuration (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=KAIZY

# Google Apps Script Web App Configuration (Alternative to SMTP)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/xxxx/exec
GOOGLE_SCRIPT_TOKEN=your-script-auth-token

# LLM Provider Configuration (at least one required)
# Primary provider: groq, mistral, openrouter, or custom
PRIMARY_PROVIDER=groq

# Groq (free tier available)
GROQ_API_KEYS=your-groq-api-key-1,your-groq-api-key-2
GROQ_MODELS=llama-3.1-8b-instant,mixtral-8x7b-32768

# Mistral AI (free tier available)
MISTRAL_API_KEYS=your-mistral-api-key-1,your-mistral-api-key-2
MISTRAL_MODELS=mistral-small-latest,mistral-medium-latest

# OpenRouter (free models available)
OPENROUTER_API_KEYS=your-openrouter-api-key-1,your-openrouter-api-key-2
OPENROUTER_MODELS=mistralai/mistral-7b-instruct:free,mistralai/mistral-7b-instruct,google/gemma-2-9b-it:free

# Custom OpenAI-compatible API
CUSTOM_API_KEYS=your-custom-api-key
CUSTOM_MODELS=gpt-3.5-turbo
CUSTOM_BASE_URL=https://api.openai.com/v1

# Admin key for cleanup endpoint
ADMIN_KEY=your-admin-secret-key

# Contact Information
CONTACT_EMAIL=sales@kaizenmeds.com
CONTACT_PHONE=+91 966 550 2190
CONTACT_WEBSITE=kaizy.com